{
  "name": "Web Crawler Example Workflow",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "crawlSingle",
        "url": "https://example.com",
        "options": {
          "headless": true,
          "timeout": 30000,
          "respectRobotsTxt": true,
          "rateLimitPoints": 5,
          "rateLimitDuration": 10,
          "retries": 3,
          "extractLinks": true,
          "extractImages": true,
          "extractMetadata": true
        },
        "outputFormat": "full"
      },
      "name": "Web Crawler - Single URL",
      "type": "n8n-nodes-base.webCrawler",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "crawlMultiple",
        "urls": "https://example.com,https://www.iana.org/domains/reserved,https://httpbin.org/html",
        "options": {
          "headless": true,
          "timeout": 30000,
          "respectRobotsTxt": true,
          "rateLimitPoints": 3,
          "rateLimitDuration": 10,
          "retries": 2
        },
        "outputFormat": "custom",
        "customFields": ["url", "title", "text", "links"]
      },
      "name": "Web Crawler - Multiple URLs",
      "type": "n8n-nodes-base.webCrawler",
      "typeVersion": 1,
      "position": [450, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/crawl",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "https://example.com"
            },
            {
              "name": "options",
              "value": {
                "headless": true,
                "timeout": 30000,
                "respectRobotsTxt": true
              }
            }
          ]
        }
      },
      "name": "HTTP Request - Crawler API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 700]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "pageTitle",
              "value": "={{ $json.title }}"
            },
            {
              "name": "linkCount",
              "value": "={{ $json.links.length }}"
            },
            {
              "name": "textPreview",
              "value": "={{ $json.text.substring(0, 200) }}"
            }
          ]
        }
      },
      "name": "Process Results",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Web Crawler - Single URL",
            "type": "main",
            "index": 0
          },
          {
            "node": "Web Crawler - Multiple URLs",
            "type": "main",
            "index": 0
          },
          {
            "node": "HTTP Request - Crawler API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Web Crawler - Single URL": {
      "main": [
        [
          {
            "node": "Process Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
